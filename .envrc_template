# PostgreSQL Configuration
export POSTGRES_DB=knowledge_base_assistant
export POSTGRES_USER=user
export POSTGRES_PASSWORD=your_postgres_password_here
export POSTGRES_PORT=5432

# Application Configuration
export OPENAI_API_KEY=your_openai_api_key_here
export APP_HOST=localhost
export APP_PORT=8000
export BASE_URL=http://${APP_HOST}:${APP_PORT}

# LLM Configuration
export TEXT_MODEL=gpt-4o-mini
export EMBED_MODEL=text-embedding-3-small

# ETL Configuration
export PROJECT_ROOT=  # Leave empty for auto-detection or set absolute path
