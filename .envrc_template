export MIN_CHARS_TO_KEEP=40

# Monitoring Configuration
export ENABLE_MONITORING=1
export AUTO_MIGRATE=1
export RUN_TIMEZONE_CHECK=1
export TZ=Europe/Berlin

# Grafana Configuration
export GRAFANA_ADMIN_USER=admin
export GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password_here
